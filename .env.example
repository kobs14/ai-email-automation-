# =============================================================================
# AI Email Automation Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# NEVER commit the .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cleaning_user
POSTGRES_PASSWORD=cleaning_password
POSTGRES_DB=cleaning_email_db

# Connection pool settings
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=          # Uncomment and set if Redis requires authentication

# -----------------------------------------------------------------------------
# Anthropic Claude API Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model settings
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development, staging, production
APP_ENV=development

# Debug mode (enables verbose logging)
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Default timezone for scheduling
TIMEZONE=America/New_York

# Response approval mode: auto, manual, hybrid
RESPONSE_APPROVAL_MODE=manual

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------------------
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# -----------------------------------------------------------------------------
# Google Calendar Integration
# -----------------------------------------------------------------------------
CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
CALENDAR_DEFAULT_DURATION=3.0
CALENDAR_BUFFER_MINUTES=30
CALENDAR_TIMEZONE=America/New_York

# -----------------------------------------------------------------------------
# CRM Integration
# -----------------------------------------------------------------------------
CRM_ENABLED=false
CRM_PROVIDER=null
# CRM_API_KEY=              # API key for the CRM provider
# CRM_API_URL=              # API URL for self-hosted CRM providers
CRM_SYNC_ENABLED=false
CRM_LOG_INTERACTIONS=true

# -----------------------------------------------------------------------------
# Flask Backend / Web Dashboard
# -----------------------------------------------------------------------------
# IMPORTANT: Change these to strong random values in production
FLASK_SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000
